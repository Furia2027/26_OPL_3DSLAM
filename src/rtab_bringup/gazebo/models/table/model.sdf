<sdf version="1.8">
    <model name="Table">
        <link name="link">
            <!-- Table Top Surface -->
            <collision name="surface">
                <pose>0 0 0.7 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.05 0.56 0.021</size>
                    </box>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.6</mu>
