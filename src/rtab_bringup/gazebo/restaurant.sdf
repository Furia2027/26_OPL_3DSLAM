<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="restaurant_world">

    <!-- Gazebo Harmonic System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun / Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Restaurant Structure -->
    <model name="restaurant">
      <static>true</static>

      <!-- Outer Wall: Top -->
      <link name="wall_outer_top">
        <pose>4.395 3.525 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.79 0.25 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.79 0.25 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: Right -->
      <link name="wall_outer_right">
        <pose>7.665 0.50 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 6.30 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 6.30 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: Left - Upper Section -->
      <link name="wall_outer_left_top">
        <pose>1.125 2.05 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 3.20 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 3.20 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: Left - Lower Section -->
      <link name="wall_outer_left_bottom">
        <pose>1.125 -1.55 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 2.20 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 2.20 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: Bottom - Left Section -->
      <link name="wall_outer_bottom_left">
        <pose>2.185 -2.525 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.37 0.25 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.37 0.25 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: Bottom - Right Section -->
      <link name="wall_outer_bottom_right">
        <pose>6.03 -2.525 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.52 0.25 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.52 0.25 0.75</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Upper Central Vertical Wall -->
      <link name="inner_wall_center_top">
        <pose>4.395 2.05 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 2.70 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 2.70 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Lower Central Vertical Wall -->
      <link name="inner_wall_center_bottom">
        <pose>4.395 -1.425 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 1.95 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 1.95 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Bed Room Bottom Wall -->
      <link name="inner_wall_bed_bottom">
        <pose>3.8 0.575 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.92 0.25 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.92 0.25 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right Area Horizontal Wall -->
      <link name="inner_wall_right_horizontal">
        <pose>6.85 0.575 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1.38 0.25 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.38 0.25 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Desk Nook Vertical Wall -->
      <link name="inner_wall_desk_nook">
        <pose>6.285 0.025 0.375 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.25 0.85 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.85 0.75</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Included Furniture Models -->

    <!-- Bedroom: Bed -->
    <include>
      <uri>model://bed</uri>
      <name>bedroom_bed</name>
      <pose>3.0 3.0 0 0 0 0</pose>
    </include>

    <!-- Living Room: Sofa -->
    <include>
      <uri>model://sofa</uri>
      <name>living_sofa</name>
      <pose>2.5 -2.0 0 0 0 1.5708</pose>
    </include>

    <!-- Dining/Top-Right Room: Dining Table -->
    <include>
      <uri>model://table</uri>
      <name>dining_table</name>
      <pose>7.0 1.0 0 0 0 0</pose>
    </include>

    <!-- Office Nook: Work Desk -->
    <include>
      <uri>model://desk</uri>
      <name>nook_desk</name>
      <pose>6.7 -0.1 0 0 0 3.14159</pose>
    </include>

  </world>
</sdf>
