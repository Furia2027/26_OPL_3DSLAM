<?xml version="1.0" encoding="utf-8"?>
<robot name="wheeltec_robot">

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0251070620224986 0.00614048061720733 0.0609796911194103" rpy="0 0 0" />
      <mass value="3.04966217910594" />
      <inertia
        ixx="0.0170838543964428" ixy="8.97603896378E-06" ixz="-0.000103914094165596"
        iyy="0.022263579823766" iyz="-1.53816933043532E-07" izz="0.0374090687091319" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/base_link.stl"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.16 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Laser Link -->
  <link name="laser_link">
    <inertial>
      <origin xyz="0.0025063031131769 -4.56584106021334E-06 -0.0193246896050287" rpy="0 0 0" />
      <mass value="0.0374307357771753" />
      <inertia
        ixx="2.80476450261731E-05" ixy="-2.19900342508599E-09" ixz="1.07118438627127E-06"
        iyy="3.36164872401846E-05" iyz="6.83963621545873E-10" izz="4.50845485902709E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/laser.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0.156198832813867 0 0.118431525059384" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser_link" />
  </joint>

  <!-- Left Front Wheel -->
  <link name="lf_wheel_link">
    <inertial>
      <origin xyz="-5.20829168682013E-09 -4.4527808014394E-07 2.77555756156289E-17" rpy="0 0 0" />
      <mass value="0.595489655285518" />
      <inertia
        ixx="0.000649719212067496" ixy="-1.0192314240505E-10" ixz="-4.88390115836518E-23"
        iyy="0.001048172608967" iyz="-1.49485089493572E-19" izz="0.000649697264639401" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/lf_wheel_link.stl" />
      </geometry>
      <material name="cyan">
        <color rgba="0.741176470588235 0.901960784313726 0.956862745098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="lf_wheel_joint" type="continuous">
    <origin xyz="0.130698832813868 0.115083999996712 0.035" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lf_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Right Front Wheel -->
  <link name="rf_wheel_link">
    <inertial>
      <origin xyz="-5.20829163130898E-09 4.45278080227207E-07 -2.77555756156289E-17" rpy="0 0 0" />
      <mass value="0.595489655285517" />
      <inertia
        ixx="0.000649719212067496" ixy="1.01923148006776E-10" ixz="4.28254399334126E-23"
        iyy="0.001048172608967" iyz="-1.50279014522297E-19" izz="0.000649697264639401" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/rf_wheel_link.stl" />
      </geometry>
      <material name="cyan">
        <color rgba="0.741176470588235 0.901960784313726 0.956862745098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rf_wheel_joint" type="continuous">
    <origin xyz="0.130698832813866 -0.115084000003288 0.035" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rf_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Rear Left Caster -->
  <link name="caster_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_left_joint" type="fixed">
    <origin xyz="-0.12 0.08 0.018" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_left_link"/>
  </joint>

  <!-- Rear Right Caster -->
  <link name="caster_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_right_joint" type="fixed">
    <origin xyz="-0.12 -0.08 0.018" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_right_link"/>
  </joint>

  <!-- Gazebo Lidar Plugin -->
  <gazebo reference="laser_link">
    <sensor type="gpu_lidar" name="generic_laser">
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Gazebo Caster Friction -->
  <gazebo reference="caster_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="caster_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- Gazebo Plugins -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>lf_wheel_joint</joint_name>
      <joint_name>rf_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>lf_wheel_joint</left_joint>
      <right_joint>rf_wheel_joint</right_joint>
      <wheel_separation>0.230168</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

</robot>
