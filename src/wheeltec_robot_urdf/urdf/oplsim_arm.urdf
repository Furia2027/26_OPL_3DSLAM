<?xml version="1.0" encoding="utf-8"?>
<robot name="wheeltec_robot">

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0251070620224986 0.00614048061720733 0.0609796911194103" rpy="0 0 0" />
      <mass value="3.04966217910594" />
      <inertia
        ixx="0.0170838543964428" ixy="8.97603896378E-06" ixz="-0.000103914094165596"
        iyy="0.022263579823766" iyz="-1.53816933043532E-07" izz="0.0374090687091319" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.142" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/base_link.stl"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.16 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Laser Link -->
  <link name="laser_link">
    <inertial>
      <origin xyz="0.0025063031131769 -4.56584106021334E-06 -0.0193246896050287" rpy="0 0 0" />
      <mass value="0.0374307357771753" />
      <inertia
        ixx="2.80476450261731E-05" ixy="-2.19900342508599E-09" ixz="1.07118438627127E-06"
        iyy="3.36164872401846E-05" iyz="6.83963621545873E-10" izz="4.50845485902709E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/laser.stl" />
      </geometry>
      <material name="dark_grey">
        <color rgba="0.376470588235294 0.376470588235294 0.376470588235294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0.156198832813867 0 0.118431525059384" rpy="0 0 3.14159265358979" />
    <parent link="base_link" />
    <child link="laser_link" />
  </joint>

  <!-- Left Front Wheel -->
  <link name="lf_wheel_link">
    <inertial>
      <origin xyz="-5.20829168682013E-09 -4.4527808014394E-07 2.77555756156289E-17" rpy="0 0 0" />
      <mass value="0.595489655285518" />
      <inertia
        ixx="0.000649719212067496" ixy="-1.0192314240505E-10" ixz="-4.88390115836518E-23"
        iyy="0.001048172608967" iyz="-1.49485089493572E-19" izz="0.000649697264639401" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/lf_wheel_link.stl" />
      </geometry>
      <material name="cyan">
        <color rgba="0.741176470588235 0.901960784313726 0.956862745098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="lf_wheel_joint" type="continuous">
    <origin xyz="0.130698832813868 0.115083999996712 0.035" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lf_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Right Front Wheel -->
  <link name="rf_wheel_link">
    <inertial>
      <origin xyz="-5.20829163130898E-09 4.45278080227207E-07 -2.77555756156289E-17" rpy="0 0 0" />
      <mass value="0.595489655285517" />
      <inertia
        ixx="0.000649719212067496" ixy="1.01923148006776E-10" ixz="4.28254399334126E-23"
        iyy="0.001048172608967" iyz="-1.50279014522297E-19" izz="0.000649697264639401" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/rf_wheel_link.stl" />
      </geometry>
      <material name="cyan">
        <color rgba="0.741176470588235 0.901960784313726 0.956862745098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267949 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rf_wheel_joint" type="continuous">
    <origin xyz="0.130698832813866 -0.115084000003288 0.035" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rf_wheel_link" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Rear Left Caster -->
  <link name="caster_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_left_joint" type="fixed">
    <origin xyz="-0.12 0.08 0.018" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_left_link"/>
  </joint>

  <!-- Rear Right Caster -->
  <link name="caster_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_right_joint" type="fixed">
    <origin xyz="-0.12 -0.08 0.018" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_right_link"/>
  </joint>

  <!-- Arm Base -->
  <link name="arm_base_link">
    <inertial>
      <origin xyz="0.00373847392098165 -1.52445893424664E-10 0.0264265327292804" rpy="0 0 0" />
      <mass value="0.326392759093976" />
      <inertia
        ixx="0.000224202818963409" ixy="-1.96773409840189E-13" ixz="-2.99224798427881E-05"
        iyy="0.000286616921839535" iyz="-3.10964171549742E-13" izz="0.000349957607258242" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/arm_base_link.stl" />
      </geometry>
      <material name="grey">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/arm_base_link.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <origin xyz="0.08 0 0.245" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_base_link" />
  </joint>

  <!-- Link 1 -->
  <link name="link1">
    <inertial>
      <origin xyz="-3.11559626639357E-12 9.70240468164796E-06 -0.0146667419724465" rpy="0 0 0" />
      <mass value="0.0928887601998397" />
      <inertia
        ixx="6.09210980255232E-05" ixy="-2.79207542479444E-18" ixz="4.24841739939559E-15"
        iyy="2.53493566630784E-05" iyz="2.16442830142331E-08" izz="4.88050835919342E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link1.stl" />
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link1.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_link1" type="revolute">
    <origin xyz="0.0100000008759151 0 0.123059270461044" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="link1" />
    <axis xyz="0 0 -1" />
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="3.0" />
  </joint>

  <!-- Link 2 -->
  <link name="link2">
    <inertial>
      <origin xyz="0.122021157535333 6.61338425981053E-05 -9.50311342843365E-05" rpy="0 0 0" />
      <mass value="0.0895817175833772" />
      <inertia
        ixx="2.6269354271334E-05" ixy="-2.55344668379587E-06" ixz="-3.90237379833709E-09"
        iyy="0.000350369536011831" iyz="-6.82396195680563E-09" izz="0.000333056833230846" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link2.stl" />
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link2.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="link1_to_link2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963267949 -1.5707963267949 0" />
    <parent link="link1" />
    <child link="link2" />
    <axis xyz="0 0 -1" />
    <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="3.0" />
  </joint>

  <!-- Link 3 -->
  <link name="link3">
    <inertial>
      <origin xyz="-0.00076280945740961 -0.114419656440929 -0.000177274968057332" rpy="0 0 0" />
      <mass value="0.123009044986454" />
      <inertia
        ixx="0.000104111883333949" ixy="1.06443789581137E-07" ixz="1.54925816846055E-07"
        iyy="1.46357151076022E-05" iyz="-1.6435520156444E-07" izz="0.000104009297710106" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/link3.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="link2_to_link3" type="revolute">
    <origin xyz="0.236815132922094 0.0300023995170449 0" rpy="1.5707963267949 0 1.5707963267949" />
    <parent link="link2" />
    <child link="link3" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="3.1416" effort="10.0" velocity="3.0" />
  </joint>

  <!-- Gripper Link -->
  <link name="gripper_link">
    <inertial>
      <origin xyz="0.0288857415118809 -0.000776842039187049 -0.000779764534254559" rpy="0 0 0" />
      <mass value="0.00365697683069397" />
      <inertia
        ixx="1.15139272656909E-06" ixy="1.31250385773157E-07" ixz="-2.41954534039415E-13"
        iyy="2.33034171341163E-06" iyz="4.1392257505497E-13" izz="1.47179863096272E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/gripper.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://wheeltec_robot_urdf/meshes/S100_diff_robot_meshes/gripper.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="link3_to_gripper_link" type="revolute">
    <origin xyz="0.246 -0.0005 0" rpy="1.5708 0 -1.5708" />
    <parent link="link3" />
    <child link="gripper_link" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="1.5" effort="5.0" velocity="3.0" />
  </joint>

  <!-- Hand TCP Frame -->
  <link name="hand_tcp"/>

  <joint name="link3_to_hand_tcp" type="fixed">
    <origin xyz="0.33022 -0.0005 0" rpy="0 0 0" />
    <parent link="link3" />
    <child link="hand_tcp" />
  </joint>

  <!-- Gazebo Caster Friction -->
  <gazebo reference="caster_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo reference="caster_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- Gazebo Plugins -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>lf_wheel_joint</joint_name>
      <joint_name>rf_wheel_joint</joint_name>
      <joint_name>base_link_to_link1</joint_name>
      <joint_name>link1_to_link2</joint_name>
      <joint_name>link2_to_link3</joint_name>
      <joint_name>link3_to_gripper_link</joint_name>
    </plugin>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>lf_wheel_joint</left_joint>
      <right_joint>rf_wheel_joint</right_joint>
      <wheel_separation>0.230168</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>
